rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // La Loba scoring is admin-only; must match the client-side admin check
    // in participant_bloc.dart (CheckAdminStatusEvent).
    function isLaLobaAdmin() {
      return isSignedIn() && request.auth.token.email == 'lfexevega95@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublishedAndActive(data) {
      return data != null && data.isActive == true && data.isPublished == true;
    }

    function isArticleOwner(data) {
      return data != null && isOwner(data.authorId);
    }

    function isValidArticleWrite() {
      return request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorEmail',
          'authorPhotoUrl',
          'title',
          'subtitle',
          'description',
          'category',
          'content',
          'urlToImage',
          'thumbnailUrl',
          'isPublished',
          'isActive',
          'createdAt',
          'updatedAt',
          'publishedAt',
          'favoritesVersion',
        ])
        && request.resource.data.authorId is string
        && request.resource.data.authorName is string
        && request.resource.data.authorEmail is string
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.category is string
        && request.resource.data.isPublished is bool
        && request.resource.data.isActive is bool
        && request.resource.data.favoritesVersion is int
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null
        && (!('authorPhotoUrl' in request.resource.data)
          || request.resource.data.authorPhotoUrl == null
          || request.resource.data.authorPhotoUrl is string)
        && (!('subtitle' in request.resource.data)
          || request.resource.data.subtitle == null
          || request.resource.data.subtitle is string)
        && (!('description' in request.resource.data)
          || request.resource.data.description == null
          || request.resource.data.description is string)
        && (!('urlToImage' in request.resource.data)
          || request.resource.data.urlToImage == null
          || request.resource.data.urlToImage is string)
        && (!('thumbnailUrl' in request.resource.data)
          || request.resource.data.thumbnailUrl == null
          || request.resource.data.thumbnailUrl is string)
        && (!('publishedAt' in request.resource.data)
          || request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is timestamp);
    }

    function isValidUserProfileWrite(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'age',
          'photoUrl',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.createdAt != null
        && request.resource.data.updatedAt != null
        && (!('age' in request.resource.data)
          || request.resource.data.age == null
          || request.resource.data.age is int)
        && (!('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl == null
          || request.resource.data.photoUrl is string);
    }

    function articlePath(articleId) {
      return /databases/$(database)/documents/articles/$(articleId);
    }

    function targetArticle(articleId) {
      return get(articlePath(articleId)).data;
    }

    function favoriteTargetsActivePublishedArticle(articleId) {
      return isPublishedAndActive(targetArticle(articleId));
    }

    function isValidFavoriteWrite(articleId) {
      return request.resource.data.keys().hasOnly([
          'articleId',
          'favoritedAt',
          'favoritesVersion',
          'firestoreId',
          'authorId',
          'author',
          'authorPhotoUrl',
          'title',
          'description',
          'category',
          'url',
          'urlToImage',
          'publishedAt',
          'content',
          'createdAt',
          'updatedAt',
          'isPublished',
          'isActive',
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.favoritedAt != null
        && request.resource.data.favoritesVersion is int
        && request.resource.data.firestoreId == articleId
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.isPublished is bool
        && request.resource.data.isActive is bool
        && (!('authorId' in request.resource.data)
          || request.resource.data.authorId == null
          || request.resource.data.authorId is string)
        && (!('author' in request.resource.data)
          || request.resource.data.author == null
          || request.resource.data.author is string)
        && (!('authorPhotoUrl' in request.resource.data)
          || request.resource.data.authorPhotoUrl == null
          || request.resource.data.authorPhotoUrl is string)
        && (!('description' in request.resource.data)
          || request.resource.data.description == null
          || request.resource.data.description is string)
        && (!('category' in request.resource.data)
          || request.resource.data.category == null
          || request.resource.data.category is string)
        && (!('url' in request.resource.data)
          || request.resource.data.url == null
          || request.resource.data.url is string)
        && (!('urlToImage' in request.resource.data)
          || request.resource.data.urlToImage == null
          || request.resource.data.urlToImage is string)
        && (!('publishedAt' in request.resource.data)
          || request.resource.data.publishedAt == null
          || request.resource.data.publishedAt is string)
        && request.resource.data.createdAt != null
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt == null
          || request.resource.data.updatedAt is timestamp);
    }

    match /articles/{articleId} {
      allow get: if isPublishedAndActive(resource.data) || isArticleOwner(resource.data);
      allow list: if isPublishedAndActive(resource.data) || isArticleOwner(resource.data);
      allow create: if isSignedIn() && isValidArticleWrite();
      allow update: if isArticleOwner(resource.data)
        && isValidArticleWrite()
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isValidUserProfileWrite(userId);
      allow delete: if false;

      match /favorites/{articleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && favoriteTargetsActivePublishedArticle(articleId)
          && isValidFavoriteWrite(articleId);
      }
    }

    // La Loba: Card Game Management
    match /participants/{participantId} {
      allow read: if true;
      allow create, update: if isLaLobaAdmin();
      allow delete: if false;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create, update: if isLaLobaAdmin();
      allow delete: if false;

      match /hands/{handId} {
        allow read: if true;
        allow create, update: if isLaLobaAdmin();
        allow delete: if false;
      }
    }

    // Truco: Card Game Management (same admin as La Loba)
    match /truco_participants/{participantId} {
      allow read: if true;
      allow create, update: if isLaLobaAdmin();
      allow delete: if false;
    }

    match /truco_games/{gameId} {
      allow read: if true;
      allow create, update: if isLaLobaAdmin();
      allow delete: if false;

      match /hands/{handId} {
        allow read: if true;
        allow create, update: if isLaLobaAdmin();
        allow delete: if false;
      }
    }

    // Dardos: Dart Game Management
    match /dardos_participants/{participantId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    match /dardos_games/{gameId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;

      match /throws/{throwId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();  // Required for undo functionality
      }
    }
  }
}
